#!/usr/bin/env bash
# Voxiva CLI — one-line installer (macOS / Linux)
#
# Primary (GitHub):
#   curl -fsSL https://raw.githubusercontent.com/voxiva-ai/cli/main/install | bash
#
# Mirror if GitHub raw is slow/blocked (CN / some networks):
#   curl -fsSL https://cdn.jsdelivr.net/gh/voxiva-ai/cli@main/install | bash
#
# Downloads Node.js (official + mirrors) into ~/.voxiva/runtime when missing,
# installs the CLI, puts a launcher on PATH. Works without a preinstalled Node.
#
# Optional:
#   VERSION=0.1.0 curl … | bash
#   VOXIVA_METHOD=github|npm|auto curl … | bash
#   VOXIVA_REGION=cn curl … | bash          # prefer China mirrors first

set -euo pipefail

VOXIVA_HOME="${VOXIVA_HOME:-$HOME/.voxiva}"
RUNTIME_DIR="$VOXIVA_HOME/runtime"
PREFIX_DIR="$VOXIVA_HOME/prefix"
BIN_DIR="$VOXIVA_HOME/bin"
NODE_MIN_MAJOR=20
NODE_FALLBACK_VERSION="22.14.0"
REPO="voxiva-ai/cli"
BRANCH="main"
VERBOSE="${VOXIVA_VERBOSE:-0}"
STARTED_AT="$(date +%s)"
SPIN_I=0
SPIN_FRAMES='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'

status() {
  if [ "$VERBOSE" = "1" ]; then
    echo "  $*"
    return
  fi
  SPIN_I=$(( (SPIN_I + 1) % 10 ))
  frame="$(printf '%s' "$SPIN_FRAMES" | cut -c$((SPIN_I + 1)))"
  printf '\r  %s  %s%-40s' "$frame" "$1" ""
}

clear_status() {
  if [ "$VERBOSE" != "1" ]; then
    printf '\r%-60s\r' ""
  fi
}

echo ""
echo "  voxiva"
status "setting up…"

mkdir -p "$VOXIVA_HOME" "$RUNTIME_DIR" "$PREFIX_DIR" "$BIN_DIR"

os="$(uname -s | tr '[:upper:]' '[:lower:]')"
arch="$(uname -m)"
case "$arch" in
  x86_64|amd64) arch="x64" ;;
  aarch64|arm64) arch="arm64" ;;
  armv7l) arch="armv7l" ;;
  *)
    echo "Unsupported CPU: $arch"
    exit 1
    ;;
esac

case "$os" in
  linux) platform="linux" ;;
  darwin) platform="darwin" ;;
  *)
    echo "Unsupported OS: $os (use install.ps1 on Windows)"
    exit 1
    ;;
esac

# Prefer CN mirrors when locale/timezone/region says so (or VOXIVA_REGION=cn).
prefer_cn=0
region_lc="$(printf '%s' "${VOXIVA_REGION:-${LANG:-}${LC_ALL:-}${TZ:-}}" | tr '[:upper:]' '[:lower:]')"
case "$region_lc" in
  *cn*|*zh*|*shanghai*|*chongqing*|*urumqi*|*hongkong*|*prc*) prefer_cn=1 ;;
esac

have_curl=0
have_wget=0
command -v curl >/dev/null 2>&1 && have_curl=1
command -v wget >/dev/null 2>&1 && have_wget=1
if [ "$have_curl" -ne 1 ] && [ "$have_wget" -ne 1 ]; then
  echo "Need curl or wget to download Node.js / CLI."
  exit 1
fi

curl_get() {
  # $1=url $2=outfile
  if [ "$have_curl" -eq 1 ]; then
    curl -fL --connect-timeout 12 --max-time 300 --retry 2 --retry-delay 1 -o "$2" "$1"
  else
    wget -q --timeout=300 -O "$2" "$1"
  fi
}

http_fetch_text() {
  # $1=url → stdout
  if [ "$have_curl" -eq 1 ]; then
    curl -fsSL --connect-timeout 12 --max-time 45 "$1"
  else
    wget -q --timeout=45 -O - "$1"
  fi
}

node_ok() {
  local bin="$1"
  [ -x "$bin" ] || return 1
  local major
  major="$("$bin" -p "process.versions.node.split('.')[0]" 2>/dev/null || true)"
  [ -n "$major" ] && [ "$major" -ge "$NODE_MIN_MAJOR" ]
}

resolve_system_node() {
  if command -v node >/dev/null 2>&1 && node_ok "$(command -v node)"; then
    command -v node
    return 0
  fi
  return 1
}

resolve_bundled_node() {
  if [ -x "$RUNTIME_DIR/current/bin/node" ] && node_ok "$RUNTIME_DIR/current/bin/node"; then
    echo "$RUNTIME_DIR/current/bin/node"
    return 0
  fi
  return 1
}

node_index_urls() {
  if [ "$prefer_cn" -eq 1 ]; then
    echo "https://cdn.npmmirror.com/binaries/node/index.json"
    echo "https://nodejs.org/dist/index.json"
  else
    echo "https://nodejs.org/dist/index.json"
    echo "https://cdn.npmmirror.com/binaries/node/index.json"
  fi
}

node_tarball_urls() {
  local version="$1"
  local base="node-v${version}-${platform}-${arch}.tar.gz"
  if [ "$prefer_cn" -eq 1 ]; then
    echo "https://cdn.npmmirror.com/binaries/node/v${version}/${base}"
    echo "https://npmmirror.com/mirrors/node/v${version}/${base}"
    echo "https://nodejs.org/dist/v${version}/${base}"
  else
    echo "https://nodejs.org/dist/v${version}/${base}"
    echo "https://cdn.npmmirror.com/binaries/node/v${version}/${base}"
    echo "https://npmmirror.com/mirrors/node/v${version}/${base}"
  fi
}

latest_lts_version() {
  local url json ver
  while IFS= read -r url; do
    json="$(http_fetch_text "$url" 2>/dev/null || true)"
    [ -z "$json" ] && continue
    ver="$(printf '%s' "$json" | tr '{' '\n' | grep '"lts":' | grep -v '"lts":false' | head -n1 | sed -n 's/.*"version":"v\([^"]*\)".*/\1/p')"
    if [ -n "$ver" ]; then
      echo "$ver"
      return
    fi
  done < <(node_index_urls)
  echo "$NODE_FALLBACK_VERSION"
}

download_node() {
  local version="$1"
  local base="node-v${version}-${platform}-${arch}"
  local tmp url
  tmp="$(mktemp -d)"
  status "downloading Node.js…"
  local ok=0
  while IFS= read -r url; do
    if curl_get "$url" "$tmp/node.tar.gz" 2>/dev/null; then
      ok=1
      break
    fi
  done < <(node_tarball_urls "$version")
  if [ "$ok" -ne 1 ]; then
    clear_status
    echo "Failed to download Node.js from all mirrors."
    rm -rf "$tmp"
    exit 1
  fi
  status "unpacking Node.js…"
  tar -xzf "$tmp/node.tar.gz" -C "$tmp"
  rm -rf "$RUNTIME_DIR/$base"
  mv "$tmp/$base" "$RUNTIME_DIR/$base"
  ln -sfn "$RUNTIME_DIR/$base" "$RUNTIME_DIR/current"
  rm -rf "$tmp"
}

ensure_node() {
  local node_bin=""
  if node_bin="$(resolve_bundled_node)"; then
    printf '%s\n' "$node_bin"
    return
  fi
  if node_bin="$(resolve_system_node)"; then
    printf '%s\n' "$node_bin"
    return
  fi
  local ver
  ver="$(latest_lts_version)"
  download_node "$ver"
  resolve_bundled_node
}

status "checking Node.js…"
NODE_BIN="$(ensure_node)"
export PATH="$(dirname "$NODE_BIN"):$PATH"

if ! command -v npm >/dev/null 2>&1; then
  if [ -x "$(dirname "$NODE_BIN")/npm" ]; then
    export PATH="$(dirname "$NODE_BIN"):$PATH"
  else
    clear_status
    echo "npm missing next to Node at $NODE_BIN"
    exit 1
  fi
fi

NPM_BIN="$(command -v npm)"

METHOD="${VOXIVA_METHOD:-auto}"
VERSION="${VERSION:-latest}"

npm_registries() {
  if [ "$prefer_cn" -eq 1 ]; then
    echo "https://registry.npmmirror.com"
    echo "https://registry.npmjs.org"
  else
    echo "https://registry.npmjs.org"
    echo "https://registry.npmmirror.com"
  fi
}

install_pkg_with_registry() {
  local spec="$1"
  local registry="$2"
  status "installing CLI…"
  npm_config_registry="$registry" npm_config_loglevel=error \
    "$NPM_BIN" install --prefix "$PREFIX_DIR" --no-fund --no-audit --fetch-retries=3 --fetch-retry-mintimeout=2000 --silent "$spec" >/dev/null 2>&1
}

install_pkg() {
  local spec="$1"
  local reg
  local last_err=1
  while IFS= read -r reg; do
    if install_pkg_with_registry "$spec" "$reg"; then
      return 0
    fi
    last_err=$?
  done < <(npm_registries)
  return "$last_err"
}

pkg_specs_auto() {
  # Prefer GitHub — npm package may not be published yet.
  echo "github:${REPO}"
  echo "https://codeload.github.com/${REPO}/tar.gz/refs/heads/${BRANCH}"
  echo "https://github.com/${REPO}/archive/refs/heads/${BRANCH}.tar.gz"
  echo "@voxiva/cli@${VERSION}"
}

install_cli() {
  local spec
  case "$METHOD" in
    npm)
      install_pkg "@voxiva/cli@${VERSION}"
      return
      ;;
    github)
      install_pkg "github:${REPO}" || install_pkg "https://codeload.github.com/${REPO}/tar.gz/refs/heads/${BRANCH}"
      return
      ;;
  esac

  while IFS= read -r spec; do
    if install_pkg "$spec"; then
      return 0
    fi
  done < <(pkg_specs_auto)
  clear_status
  echo "All package sources failed."
  exit 1
}

install_cli

# If git install brought sources without dist, build once.
PKG_ROOT=""
for candidate in \
  "$PREFIX_DIR/lib/node_modules/@voxiva/cli" \
  "$PREFIX_DIR/node_modules/@voxiva/cli"
do
  if [ -d "$candidate" ]; then
    PKG_ROOT="$candidate"
    break
  fi
done

if [ -n "$PKG_ROOT" ] && [ ! -f "$PKG_ROOT/dist/index.js" ]; then
  status "building…"
  (
    cd "$PKG_ROOT"
    if [ -f package-lock.json ]; then
      "$NPM_BIN" ci --no-fund --no-audit --silent >/dev/null 2>&1 || "$NPM_BIN" install --no-fund --no-audit --silent >/dev/null 2>&1
    else
      "$NPM_BIN" install --no-fund --no-audit --silent >/dev/null 2>&1
    fi
    "$NPM_BIN" run build --silent >/dev/null 2>&1
  )
fi

PKG_ENTRY=""
for candidate in \
  "$PREFIX_DIR/lib/node_modules/@voxiva/cli/dist/index.js" \
  "$PREFIX_DIR/node_modules/@voxiva/cli/dist/index.js"
do
  if [ -f "$candidate" ]; then
    PKG_ENTRY="$candidate"
    break
  fi
done

if [ -z "$PKG_ENTRY" ]; then
  echo "Install finished but package entry not found under $PREFIX_DIR"
  exit 1
fi

cat > "$BIN_DIR/voxiva" <<EOF
#!/usr/bin/env bash
set -euo pipefail
HOME_DIR="\${VOXIVA_HOME:-\$HOME/.voxiva}"
NODE="\$HOME_DIR/runtime/current/bin/node"
ENTRY=""
for c in \\
  "\$HOME_DIR/prefix/lib/node_modules/@voxiva/cli/dist/index.js" \\
  "\$HOME_DIR/prefix/node_modules/@voxiva/cli/dist/index.js"
do
  [ -f "\$c" ] && ENTRY="\$c" && break
done
if [ ! -x "\$NODE" ]; then
  if command -v node >/dev/null 2>&1; then
    NODE="\$(command -v node)"
  else
    echo "Node.js missing. Re-run installer:"
    echo "  curl -fsSL https://cdn.jsdelivr.net/gh/voxiva-ai/cli@main/install | bash"
    exit 1
  fi
fi
if [ -z "\$ENTRY" ] || [ ! -f "\$ENTRY" ]; then
  echo "Voxiva CLI files missing. Re-run the installer."
  exit 1
fi
exec "\$NODE" "\$ENTRY" "\$@"
EOF
chmod +x "$BIN_DIR/voxiva"

LOCAL_BIN="$HOME/.local/bin"
mkdir -p "$LOCAL_BIN"
ln -sfn "$BIN_DIR/voxiva" "$LOCAL_BIN/voxiva"

path_line='export PATH="$HOME/.voxiva/bin:$HOME/.local/bin:$PATH"'
for rc in "$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.profile"; do
  if [ -f "$rc" ] || [ "$rc" = "$HOME/.profile" ]; then
    [ -f "$rc" ] || touch "$rc"
    if ! grep -qF '.voxiva/bin' "$rc" 2>/dev/null; then
      printf '\n# Voxiva CLI\n%s\n' "$path_line" >> "$rc"
    fi
  fi
done

export PATH="$BIN_DIR:$LOCAL_BIN:$PATH"

status "finishing…"
VER_OUT="$("$BIN_DIR/voxiva" --version 2>/dev/null || true)"
ELAPSED="$(( $(date +%s) - STARTED_AT ))"
FAKE_TOKENS="$((1200 + ELAPSED * 37 + RANDOM % 400))"
JOKES=(
  "Tokens burned by this install: 0. Tokens we pretended to burn: ${FAKE_TOKENS}."
  "Your wallet lost \$0.00. Your dignity: still buffering."
  "Free models unlocked. Paid anxiety: optional."
  "Context window used for install logs: intentionally tiny."
)
JOKE="${JOKES[$((RANDOM % ${#JOKES[@]}))]}"

clear_status
echo ""
echo "  ✓  ready  ·  ${ELAPSED}s"
echo "  $JOKE"
echo ""
echo "  Open a new terminal and type:"
echo ""
echo "    voxiva"
echo ""
if [ -n "$VER_OUT" ]; then
  echo "  $VER_OUT"
  echo ""
fi
